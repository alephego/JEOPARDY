<!doctype html><html lang="en"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>JEOPARDY - Hub</title><link rel="stylesheet" href="CSS/app.css"><link rel="stylesheet" href="CSS/rules-info.css"></head><body>
<main class="screen center"><section class="panel hub">
<div class="eyebrow">MULTIPLAYER QUIZ</div><h1>JEOPARDY</h1><p class="subtitle">Create a room or join one.</p>
<label>YOUR NAME</label><input id="name" maxlength="20" placeholder="Enter your name">
<div class="section-label">INTERFACE THEME</div>
<select id="uiTheme" class="theme-select">
<option value="neon">NEON ARCADE</option>
<option value="midnight">MIDNIGHT</option>
<option value="gold">GOLD ARCADE</option>
</select>
    <p class="join-role-note">New players enter as PLAYER. The GM can switch them to SPECTATOR in the waiting room.</p>

    <div class="button-row"><button id="join" class="btn secondary">JOIN GAME</button><button id="make" class="btn primary">MAKE ROOM</button></div>
<div id="joinArea" class="join-area hidden"><label>ROOM CODE</label><input id="code" maxlength="6" placeholder="ABC123"><button id="enter" class="btn primary">ENTER ROOM</button></div>
<p id="msg" class="message"></p></section></main>
<script src="/socket.io/socket.io.js"></script><script src="JS/hub.js"></script><script src="JS/rules-info.js"></script></body></html>